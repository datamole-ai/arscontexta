# Convco rules for PR titles and release version selection.
# scripts/prepare-release.sh maps feat and fix to patch, breaking changes to minor,
# and all other types to no release. Use ! only for an incompatible supported contract.

types:
  - type: feat
  - type: fix
  - type: docs
  - type: refactor
  - type: perf
  - type: test
  - type: build
  - type: ci
  - type: chore

# Scopes are optional. When useful, name the affected subsystem in lowercase kebab-case.
scopeRegex: "^([a-z][a-z0-9-]*)?$"

lineLength: 100
