# Release: feat/fix -> patch; breaking -> minor; everything else -> none.

types:
  # Generated vault
  - type: feat
  - type: fix
  - type: refactor
  - type: perf

  # Repository only
  - type: docs
  - type: test
  - type: build
  - type: ci
  - type: chore

# Optional lowercase kebab-case subsystem.
scopeRegex: "^([a-z][a-z0-9-]*)?$"

lineLength: 100
